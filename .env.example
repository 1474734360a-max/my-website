# ==========================================
# 网站环境配置模板 (复制为 .env 使用)
# ==========================================

# 服务端口与监听绑定
PORT=8686
HOST=0.0.0.0

# TronGrid API 密钥 (用于前端/后端获取公开链上 TRC20 交易数据)
# 可在 https://www.trongrid.io 免费注册申请
TRON_PRO_API_KEY=your_trongrid_api_key_here

# 链上监控地址 (反诈演示所抓取的公开 TRC20 广播账户)
TRON_MONITOR_ADDRESS=TDoXUNZ6PajKuiUkcYg3EDSV9bnqGqsbcf

# 运行环境: development / production
NODE_ENV=production
