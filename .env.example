# ============ 极赞自助下单 · 运行配置 ============
# 复制为 .env 后按需修改(或直接以环境变量方式传入)

# 演示模式: 1=全仿真(默认, 收款地址为假, 开放 /dev/demo/pay 模拟到账入口)
#           0=关闭演示入口(页面不再显示任何"模拟转账"按钮; 若未配置 Epusdt 则仍走仿真地址)
DEMO_MODE=1

# USDT 汇率(1 USDT ≈ N 元人民币), 仅用于金额折算展示
USDT_RATE=7.25

# 在线客服链接(导航/页脚), 支持 Telegram / 任意外链
SERVICE_URL=https://t.me/douyinfast_admin
SERVICE_NAME=在线客服

# 订单收银台有效期(秒), 默认 1800 = 30 分钟
ORDER_EXPIRE_SECONDS=1800

# ---- 真实 Epusdt 收款(默认全部留空, 不启用) ----
# 已按官方协议实装(创建交易 + 回调验签 + 自动发货), 启用条件:
#   1) DEMO_MODE=0
#   2) 填齐下面四项
#   3) SITE_URL 必须是 epusdt 实例能访问到的公网/局域网地址(本机 127.0.0.1 回调不可达,
#      联调可用内网穿透: cloudflared tunnel / ngrok 等)
EPUSDT_API_URL=
EPUSDT_MERCHANT_ID=
EPUSDT_TOKEN=
SITE_URL=
# 注意: Epusdt 按人民币计价(amount=CNY), 本站 cny = U数 x USDT_RATE 传给网关,
#       epusdt 自行按汇率换算成应付 USDT(actual_amount)生成收款地址。
# 测试网联调: 将 epusdt 的 TRON 节点指向 Shasta 测试网(https://api.shasta.trongrid.io)
#       并用测试 USDT 转账验证完整链路, 不触碰真钱。详见 README「测试网联调」。

# 服务端口
PORT=8686
