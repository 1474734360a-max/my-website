{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/user/api/index/latestOrders",
      "schedule": "0 * * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "*.vercel.app" }
      ],
      "destination": "https://heiu.store/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 30,
      "excludeFiles": "{data/**,dev/**,.venv/**}"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
